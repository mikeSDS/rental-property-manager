@using RentalPropertyManager.ViewModels
@model PropertyFormViewModel

<div class="modal fade" id="propertyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(Model?.Id.HasValue == true ? "Edit Property" : "Create Property")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="propertyForm">
                <div class="modal-body">
                    @if (Model?.Id.HasValue == true)
                    {
                        <input type="hidden" name="id" value="@Model.Id" />
                    }

                    <div class="mb-3">
                        <label for="name" class="form-label">Property Name *</label>
                        <input type="text" class="form-control" id="name" name="name" value="@Model?.Name" required maxlength="150" />
                        <span class="text-danger" data-valmsg-for="Name"></span>
                    </div>

                    <div class="mb-3">
                        <label for="streetAddress" class="form-label">Street Address</label>
                        <input type="text" class="form-control" id="streetAddress" name="streetAddress" value="@Model?.StreetAddress" maxlength="200" />
                        <span class="text-danger" data-valmsg-for="StreetAddress"></span>
                    </div>

                    <div class="mb-3">
                        <label for="city" class="form-label">City</label>
                        <input type="text" class="form-control" id="city" name="city" value="@Model?.City" maxlength="100" />
                        <span class="text-danger" data-valmsg-for="City"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="state" class="form-label">State</label>
                                <input type="text" class="form-control" id="state" name="state" value="@Model?.State" maxlength="50" />
                                <span class="text-danger" data-valmsg-for="State"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="zipCode" class="form-label">Zip Code</label>
                                <input type="text" class="form-control" id="zipCode" name="zipCode" value="@Model?.ZipCode" maxlength="20" />
                                <span class="text-danger" data-valmsg-for="ZipCode"></span>
                            </div>
                        </div>
                    </div>

                    <div id="formErrors"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">@(Model?.Id.HasValue == true ? "Update" : "Create")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/property-modal.js"></script>
<script>
    // Set form data attributes for modal handling
    const form = document.getElementById("propertyForm");
    if (form) {
        form.dataset.isEdit = @(Model?.Id.HasValue == true ? "true" : "false");
        form.dataset.propertyId = @(Model?.Id ?? 0);
    }

    // Initialize the form handler
    if (typeof initializePropertyForm === "function") {
        initializePropertyForm();
    }
</script>

