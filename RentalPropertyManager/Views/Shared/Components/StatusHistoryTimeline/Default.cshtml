@model List<RentalPropertyManager.ViewModels.Review.StatusHistoryItemViewModel>

@if (Model.Count == 0)
{
    <p class="text-muted">No history recorded yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var item in Model)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <div>
                        <strong>@item.ActionName</strong>
                        @if (!string.IsNullOrEmpty(item.FromStatus))
                        {
                            <span class="text-muted">@item.FromStatus &rarr;</span>
                        }
                        <span class="badge @item.BadgeCssClass">@item.ToStatus</span>
                    </div>
                    <small class="text-muted">@item.Timestamp.ToString("yyyy-MM-dd HH:mm") UTC</small>
                </div>
                <div><small>by @item.ActorName</small></div>
                @if (!string.IsNullOrWhiteSpace(item.Comment))
                {
                    <div class="mt-1">@item.Comment</div>
                }
            </li>
        }
    </ul>
}
