@model RentalPropertyManager.ViewModels.Applications.ResidenceModalViewModel
@{
    var isEdit = Model.ResidenceID > 0;
}

<div class="modal fade" id="residenceModal" tabindex="-1" aria-labelledby="residenceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" id="residenceModalDialog">
        <div class="modal-content">
            <form id="residenceForm" method="post" asp-controller="Application" asp-action="SaveResidence" asp-antiforgery="false" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ResidenceID" />
                <input type="hidden" asp-for="ApplicationID" />
                <input type="hidden" asp-for="ApplicantID" />

                <div class="modal-header">
                    <h5 class="modal-title" id="residenceModalLabel">@(isEdit ? "Edit Residence" : "Add Residence")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="State" class="form-label"></label>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Zip" class="form-label"></label>
                            <input asp-for="Zip" class="form-control" />
                            <span asp-validation-for="Zip" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LandlordName" class="form-label"></label>
                            <input asp-for="LandlordName" class="form-control" />
                            <span asp-validation-for="LandlordName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LandlordPhone" class="form-label"></label>
                            <input asp-for="LandlordPhone" class="form-control" />
                            <span asp-validation-for="LandlordPhone" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MoveInDate" class="form-label"></label>
                            <input asp-for="MoveInDate" type="date" class="form-control" />
                            <span asp-validation-for="MoveInDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MoveOutDate" class="form-label"></label>
                            <input asp-for="MoveOutDate" type="date" class="form-control" />
                            <span asp-validation-for="MoveOutDate" class="text-danger"></span>
                            <div class="form-text">Leave blank for your current residence.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
