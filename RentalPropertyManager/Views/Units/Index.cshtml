@{
    ViewData["Title"] = "Units Management";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>Units</h1>
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-primary" id="createUnitBtn">
                <i class="bi bi-plus-circle"></i> Create Unit
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover" id="unitsTable">
                <thead class="table-dark">
                    <tr>
                        <th>Property</th>
                        <th>Unit #</th>
                        <th>Bedrooms</th>
                        <th>Monthly Rent</th>
                        <th>Type</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="unitsTableBody">
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Container -->
<div id="unitModalContainer"></div>

@section Scripts {
    <script src="~/js/units-index.js"></script>
}
