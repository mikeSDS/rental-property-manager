@using RentalPropertyManager.Models
@model List<RentalPropertyManager.ViewModels.Applications.ApplicationListItemViewModel>

@if (Model.Count == 0)
{
    <p class="text-muted">No applications found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Property</th>
                <th>Unit</th>
                <th>Applicant</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Date.ToString("yyyy-MM-dd")</td>
                    <td>@item.PropertyName</td>
                    <td>@item.UnitNumber</td>
                    <td>@item.PrimaryApplicantName</td>
                    <td><span class="badge @ApplicationStatus.BadgeCssClass(item.StatusName)">@item.StatusName</span></td>
                    <td class="text-end">
                        @if (User.IsInRole("Applicant"))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Application" asp-action="Wizard" asp-route-id="@item.Id">
                                @(ApplicationStatus.IsEditable(item.StatusName) ? "Continue" : "View")
                            </a>
                            @if (ApplicationStatus.CanWithdraw(item.StatusName))
                            {
                                <form method="post" asp-controller="Application" asp-action="Withdraw" asp-route-id="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
